<table class='mcnCaptionBlock' border='0' cellpadding='0' cellspacing='0' width='100%'>
  <tbody class='mcnCaptionBlockOuter'>
    <tr>
      <td class='mcnTextContent' valign='top' style='padding: 9px 18px;'>
        <table class='mcnCaptionBlock' border='0' cellpadding='0' cellspacing='0' width='100%'>
          <tr class='bg-soft' style='font-size: 12px;'>
            <th>{{ t('pax_title') }}</th>
            <th>{{ t('name') }}</th>
            <th>{{ t('last_name') }}</th>
            <th>{{ t('passport') }}</th>
          </tr>
          {% for pax in booking.paxes %}
            <tr class='itineraryrow title' style='font-size: 11px;'>
              <td style='white-space: nowrap; padding-right: 10px;'>{{ pax.title or pax.gender }}</td>
              <td style='white-space: nowrap; padding-right: 10px;'>{{ pax.name }}</td>
              <td style='white-space: nowrap; padding-right: 10px;'>{{ pax.lastname }}</td>
              <td style='white-space: nowrap; padding-right: 10px;'>
                {% if pax.passportfile and pax.passportfile.url %}
                  <span style='color: #2e7d32;'>
                    {{ t('passport_uploaded') }}
                  </span>
                {% else %}
                  <span style='color: #c62828;'>
                    {{ t('passport_not_uploaded') }}
                  </span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          <tr>
            <td colspan='4'>
              <strong>
                <hr />
              </strong>
            </td>
          </tr>
        </table>
      </td>
    </tr>

  </tbody>
</table>
