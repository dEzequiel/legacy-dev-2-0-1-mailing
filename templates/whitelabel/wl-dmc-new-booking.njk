{% extends '../layouts/yto-layout.njk' %}
{% set dmc = booking.dmc %}
{% set product = booking.products[0] %}
{% set products = booking.products %}
{% block body %}
<tr>
    <td align="center" valign="top">
        <!-- BEGIN HEADER // -->
        <table border="0" cellpadding="0" cellspacing="0" width="600" id="templateHeader">
            <tr>
                <td valign="top" class="headerContainer">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" class="mcnTextBlock">
                    <tbody class="mcnTextBlockOuter">
                        <tr>
                            <td valign="top" class="mcnTextBlockInner">
                                <table align="left" border="0" cellpadding="0" cellspacing="0" width="600" class="mcnTextContentContainer">
                                    <tbody><tr>
                                        <td valign="top" class="mcnTextContent" style="padding-top:9px; padding-right: 18px; padding-bottom: 9px; padding-left: 18px;">
                                            &nbsp;
                                            <h1>{{ t('new_booking') }}
                                               </h1>
                                        </td>
                                    </tr>
                                </tbody></table>

                            </td>
                        </tr>
                    </tbody>
                </table>
                </td>
            </tr>
        </table>
        <!-- // END HEADER -->
    </td>
</tr>
<tr>
    <td align="center" valign="top">
        <!-- BEGIN BODY // -->
        <table border="0" cellpadding="0" cellspacing="0" width="600" id="templateBody">
            <tr>
                <td valign="top" class="bodyContainer">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" class="mcnTextBlock">
                <tbody class="mcnTextBlockOuter">
                    <tr>
                        <td valign="top" class="mcnTextBlockInner">

                        <!-- BEGIN booking // -->
                        {% include "../partials/wl-booking.njk" %}
                        {% include "../partials/wl-freesale.njk" %}
                        {% include "../partials/booking.njk" %}
                        <!-- // END booking -->

                        <!-- BEGIN Call to action -->
                        {% set ca = { txt: t('go_to_booking'), url: 'http://openmarket.travel/dmc-booking?idbooking=' + idBooking } %}
                        {% include "../partials/call-to-action.njk" %}
                        <!-- END Call to action -->

                        <!-- BEGIN message // -->

                        <!-- // END message -->
                        {% if booking.affiliate %}
                        {% include "../partials/yto-message-question.njk" %}
                        {% else %}
                        {% include "../partials/yto-message-question.njk" %}
                        {% endif %}
                        </td>
                    </tr>
                </table>
                </td>
            </tr>
        </table>
        <!-- // END BODY -->
    </td>
</tr>
{% endblock %}