{% extends '../layouts/yto-layout.njk' %}
{% from "../partials/text-block.njk" import textBlock %}

{% block body %}
  <tr>
    <td align='center' valign='top'>
      <!-- BEGIN HEADER // -->
      <table id='templateHeader' border='0' cellpadding='0' cellspacing='0' width='100%'>
        <tr>
          <td class='headerContainer' valign='top'>
            {% call textBlock('100%') %}
              &nbsp;
              <h1>
                {{ t('new_message_for_your_tailormade', { code: request.code }) }}
              </h1>
              <p>
                {{ t('agency') }}:<strong>{{ affiliate.company.name }}</strong>
                <br />
                {{ t('pax_group_name') }}
                <strong>{{ request.title }}</strong>
              </p>
              <p><strong>{{ t('email') }}</strong> {{ affiliate.contact.bookingContact.email }}</p>
            {% endcall %}

            {% include "../partials/chat-message.njk" %}

            <!-- TAILOR MADE DETAILS // -->
            {% include "../partials/tailormade.njk" %}
          </td>
        </tr>
      </table>
      <!-- // END HEADER -->
    </td>
  </tr>
  <tr>
    <td align='center' valign='top'>
      <!-- BEGIN BODY // -->
      <table id='templateBody' border='0' cellpadding='0' cellspacing='0' width='100%'>
        <tr>
          <td class='bodyContainer' valign='top'>
            <br />
            <!-- BEGIN Call to action -->
            {% if not ca %}
              {% set ca = { txt: t('go_to_request'), url: url } %}
            {% endif %}
            {% include "../partials/call-to-action.njk" %}
            <!-- END Call to action -->
            <br />
          </td>
        </tr>
      </table>
      <!-- // END BODY -->
    </td>
  </tr>
{% endblock %}
