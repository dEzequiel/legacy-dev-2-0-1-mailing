{% extends '../layouts/yto-layout.njk' %}
{% from "../partials/text-block.njk" import textBlock %}

{% block body %}
  <tr>
    <td align='center' valign='top'>
      <!-- BEGIN HEADER // -->
      <table id='templateHeader' border='0' cellpadding='0' cellspacing='0' width='600'>
        <tr>
          <td class='headerContainer' valign='top'>
            {% call textBlock('100%') %}
              &nbsp;
              <h1>
                {{ t('new_registration') }}
              </h1>
            {% endcall %}
            {% call textBlock('100%') %}
              {{ t('new_agency_intro') }}
            {% endcall %}
          </td>
        </tr>
      </table>
      <!-- // END HEADER -->
    </td>
  </tr>

  <tr>
    <td align='center' valign='top'>
      <!-- BEGIN BODY // -->
      <table id='templateBody' border='0' cellpadding='0' cellspacing='0' width='600'>
        <tr>
          <td class='bodyContainer' valign='top'>
            <table class='mcnTextBlock' border='0' cellpadding='0' cellspacing='0' width='100%'>
              <tbody class='mcnTextBlockOuter'>
                <tr>
                  <td class='mcnTextBlockInner' valign='top'>
                    <table
                      class='mcnTextContentContainer'
                      align='left'
                      border='0'
                      cellpadding='0'
                      cellspacing='0'
                      width='600'
                    >
                      <tbody>
                        <tr>
                          <td
                            class='mcnTextContent'
                            valign='top'
                            style='padding-top:9px; padding-right: 18px; padding-bottom: 9px; padding-left: 18px;'
                          >

                            {% include "../partials/affiliate-information.njk" %}

                          </td>
                        </tr>
                      </tbody>
                    </table>

                    <!-- BEGIN Call to action
http://yourttoo.com/affiliate/account/?code={{company.code}}
 -->
                    {% set ca = {txt: t('go_to_registration'), url: url} %}
                    {% include "../partials/call-to-action.njk" %}
                    <!-- END Call to action -->

                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </table>
      <!-- // END BODY -->
    </td>
  </tr>
{% endblock %}
