{% extends '../layouts/yto-layout.njk' %}

{% block body %}
  <tr>
    <td align='center' valign='top'>
      <!-- BEGIN HEADER // -->
      <table id='templateHeader' border='0' cellpadding='0' cellspacing='0' width='100%'>
        <tr>
          <td class='headerContainer' valign='top'>
            <table class='mcnTextBlock' border='0' cellpadding='0' cellspacing='0' width='100%'>
              <tbody class='mcnTextBlockOuter'>
                <tr>
                  <td class='mcnTextBlockInner' valign='top'>
                    <table
                      class='mcnTextContentContainer'
                      align='left'
                      border='0'
                      cellpadding='0'
                      cellspacing='0'
                      width='100%'
                    >
                      <tbody>
                        <tr>
                          <td
                            class='mcnTextContent'
                            valign='top'
                            style='padding-top:9px; padding-right: 18px; padding-bottom: 9px; padding-left: 18px;'
                          >
                            &nbsp;
                            <h1>{{ t('new_message_for_booking', { id: booking.idBooking }) }}</h1>
                          </td>
                        </tr>
                        <tr>
                          <td class='mcnTextContent' style='padding-left:18px;'>
                            <b>{{ t('expediente') }} {{ affiliate.company.name or affiliate.name }}:</b>
                            {{ booking.idBookingExt }}
                          </td>
                        </tr>
                        <tr>
                          <td class='mcnTextContent' style='padding-left:18px;'>
                            <b>{{ t('program') }}:</b>
                            {{ product['title_' + lang] }}
                          </td>
                        </tr>
                        <tr>
                          <td class='mcnTextContent' style='padding-left:18px;'>
                            <b>{{ t('travel_date') }}:</b>
                            {{ booking.dates.start.day }}
                            {{ booking.dates.start.monthname_en }}
                            {{ booking.dates.start.year }}
                          </td>
                        </tr>
                        <tr>
                          <td class='mcnTextContent' style='padding-left:18px;'>
                            <b>{{ t('paxes') }}:</b>
                            {{ booking.paxes.length }}
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </table>
      <!-- // END HEADER -->
    </td>
  </tr>

  <tr>
    <td align='center' valign='top'>
      <!-- BEGIN BODY // -->
      <table id='templateBody' border='0' cellpadding='0' cellspacing='0' width='100%'>
        <tr>
          <td class='bodyContainer' valign='top'>
            <table class='mcnBoxedTextBlock' border='0' cellpadding='0' cellspacing='0' width='100%'>
              <tbody class='mcnBoxedTextBlockOuter'>
                <tr>
                  <td class='mcnBoxedTextBlockInner' valign='top'>
                    <table
                      class='mcnTextContentContainer'
                      border='0'
                      cellpadding='5'
                      cellspacing='0'
                      width='100%'
                      style='background-color: #FCF8E3;'
                    >
                      <tbody>
                        <tr>
                          <td class='mcnTextContent' valign='top' style='padding: 9px 18px; text-align: left;'>
                            <table class='mcnTextContentContainer' border='0' cellpadding='5' cellspacing='0'>
                              <tbody>
                                <tr>
                                  <td width='50' valign='top' align='center'>
                                    <img
                                      height='36'
                                      src='{{ content.from.avatarimg }}'
                                      style='height: 36px; width: 36px;'
                                      width='36'
                                    />
                                  </td>
                                  <td>
                                    <strong style='line-height: 120%'>{{ content.from.name }}:</strong>
                                    <br />
                                    <em style='color:#999999'>"{{ content.message }}"</em>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>

            <table class='mcnTextBlock' border='0' cellpadding='0' cellspacing='0' width='100%'>
              <tbody class='mcnTextBlockOuter'>
                <tr>
                  <td class='mcnTextBlockInner' valign='top'>
                    <br />
                    {% if not ca %}
                      {% set ca = { txt: t('go_to_messaging'), url: url + '#tabmessage' } %}
                    {% endif %}
                    {% include "../partials/call-to-action.njk" %}

                    <!-- BEGIN message // -->
                    {% include "../partials/yto-team-thanks-message.njk" %}
                    <!-- // END message -->
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </table>
      <!-- // END BODY -->
    </td>
  </tr>
{% endblock %}
