{% extends '../layouts/yto-layout.njk' %}
{% from "../partials/text-block.njk" import textBlock %}

{% block body %}
  <tr>
    <td align='center' valign='top'>
      <table id='templateHeader' border='0' cellpadding='0' cellspacing='0' width='600'>
        <tr>
          <td class='headerContainer' valign='top'>
            {% call textBlock('100%') %}
              <h1 class='null'>
                {{ t('welcome_yourttoo') }}
              </h1>
            {% endcall %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td align='center' valign='top'>
      <table id='templateBody' border='0' cellpadding='0' cellspacing='0' width='100%'>
        <tr>
          <td class='bodyContainer' valign='top'>
            {% call textBlock('100%') %}
              <p>
                {{ t('registration_approved') }}
              </p>
              <ul>
                <li>{{ t('company_data') }}</li>
                <li>{{ t('commission_fee') }}</li>
                <li>{{ t('custom_logo') }}</li>
              </ul>
              <p>
                {{ t('agreement_reminder') }}
              </p>
            {% endcall %}

            <!-- BEGIN Call to action
                    http://www.yourttoo.com
                     -->
            {% set ca = { txt: t('go_to_yourttoo'), url: url } %}
            {% include "../partials/call-to-action.njk" %}
            <!-- END Call to action -->

            <!-- BEGIN message // -->
            {% include "../partials/yto-team-thanks-message.njk" %}
            <!-- // END message -->
          </td>
        </tr>
      </table>
    </td>
  </tr>
{% endblock %}
