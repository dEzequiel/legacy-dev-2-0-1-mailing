{% extends '../layouts/yto-layout.njk' %}
{% from "../partials/text-block.njk" import textBlock %}

{% block body %}
  <tr>
    <td align='center' valign='top'>
      <!-- BEGIN HEADER // -->
      <table id='templateHeader' border='0' cellpadding='0' cellspacing='0' width='600'>
        <tr>
          <td class='headerContainer' valign='top'>
            {% call textBlock('100%') %}
              &nbsp;
              <h1>
                {{ t('your_booking', { id: booking.idBooking }) }}
              </h1>
              <br />
              <b>{{ t('expediente') }} {{ affiliate.company.name }}:</b>
              {{ booking.idBookingExt }}
              <br />
              <b>{{ t('program') }}:</b>
              {{ booking.products[0]['title_' + lang] }}
              <br />
              <b>{{ t('travel_date') }}:</b>
              {{ booking.dates.start.day }}
              {{ booking.dates.start.monthname_en }}
              {{ booking.dates.start.year }}
              <br />
              <b>{{ t('paxes') }}:</b>
              {{ booking.paxes.length }}
            {% endcall %}

            {% include "../partials/passengers-table-passports.njk" %}

            {% call textBlock('100%') %}
              {{ t('passport_claim_text') | safe }}
            {% endcall %}
          </td>
        </tr>
      </table>
      <!-- // END HEADER -->
    </td>
  </tr>

  <tr>
    <td align='center' valign='top'>
      <!-- BEGIN BODY // -->
      <table id='templateBody' border='0' cellpadding='0' cellspacing='0' width='100%'>
        <tr>
          <td class='bodyContainer' valign='top'>
            {% call textBlock('100%') %}
              {% set ca ={
                  txt: t(
                    'go_to_booking'
                  ),
                  url: 'http://yourttoo.com/edit/booking?code=' + booking.idBooking
                }
              %}
              {% include "../partials/call-to-action.njk" %}
              <!-- END Call to action -->

              <!-- BEGIN message // -->
              {% include "../partials/yto-team-thanks-message.njk" %}
              <!-- // END message -->
            {% endcall %}
          </td>
        </tr>
      </table>
      <!-- // END BODY -->
    </td>
  </tr>
{% endblock %}
